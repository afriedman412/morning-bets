<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.morningbets.backfill</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scratchpad/cron_backfill.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- 07:30, comfortably before the 08:05 first pull. ONCE A DAY, on
       purpose: the backfill rewrites games already in the set, which
       moves our price for a data reason. Between hourly pulls that would
       be indistinguishable from the market moving on information, which
       is the only thing the hourly series exists to show. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>AbandonProcessGroup</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/backfill.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/backfill.launchd.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
